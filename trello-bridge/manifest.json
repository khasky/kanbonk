{
  "manifest_version": 3,
  "name": "Kanbonk Trello Import",
  "version": "0.1.0",
  "key": "",
  "host_permissions": [
    "https://trello.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://trello.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "worker.js"
  }
}

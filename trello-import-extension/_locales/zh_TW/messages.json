{
  "appName": {
    "message": "Kanbonk Trello 匯入"
  },
  "appDescription": {
    "message": "將 Trello 看板連同所有檔案匯出供 Kanbonk 使用，並讓 localhost 上的 Kanbonk 取得 Trello 附件。"
  },

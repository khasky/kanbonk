      "files": {
        "content": "$2",
        "example": "9"
      },
      "total": {
        "content": "$3",
        "example": "10"
      }
    }
  },
  "doneManyParts": {
    "message": "Готово. Частей: $PARTS$, файлов: $FILES$ из $TOTAL$.\nВ Kanbonk откройте ⋯ → Импорт из Trello и выберите все части сразу.",
    "placeholders": {
      "parts": {
        "content": "$1",
        "example": "3"

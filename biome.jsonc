{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // JSON and Markdown are left as written: manifests are edited by tools, docs by hand.
    "includes": ["**", "!src-tauri/gen", "!src-tauri/target", "!**/*.json", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    // Playwright rules apply to the e2e tests only (see overrides); in src they misread a describe() helper.
    "domains": { "playwright": "none" },
    "rules": {
      "preset": "recommended",
      // Rules below are off because satisfying them changes behavior or markup, not just style.
      // Turning one on is a change of its own, checked in the running app.
      "a11y": "off",
      "style": {
        // Used where the data model guarantees presence (e.g. a card's list).
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // Filename sanitizing strips control characters on purpose.
        "noControlCharactersInRegex": "off",
        // Static lists rendered once; keys by index are stable there.
        "noArrayIndexKey": "off"
      },
      "security": {
        // The only use inserts the QR code SVG that share.ts generates from the card link.
        "noDangerouslySetInnerHtml": "off"
      },
      "correctness": {
        // Effects that re-run on a trigger they don't read say so with a biome-ignore comment.
        "useExhaustiveDependencies": "error"
      }
    }
  },
  "css": {
    // Tailwind v4 at-rules (@theme) in src/styles/index.css.
    "parser": { "tailwindDirectives": true },
    "linter": { "enabled": true },
    "formatter": { "enabled": true }
  },
  "overrides": [
    {
      // Reordering selectors or dropping !important changes the cascade.
      "includes": ["**/*.css"],
      "linter": {
        "rules": { "style": { "noDescendingSpecificity": "off" }, "complexity": { "noImportantStyles": "off" } }
      }
    },
    {
      "includes": ["e2e/**"],
      "linter": { "domains": { "playwright": "recommended" } }
    },
    {
      // Compares ISO date strings; Math.max would turn them into NaN.
      "includes": ["src/sync/sync.ts"],
      "linter": { "rules": { "complexity": { "useMathMinMax": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}

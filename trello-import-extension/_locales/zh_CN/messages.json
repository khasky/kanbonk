{
  "appName": {
    "message": "Kanbonk Trello 导入"
  },
  "appDescription": {
    "message": "将 Trello 看板连同所有文件导出供 Kanbonk 使用，并允许 localhost 上的 Kanbonk 获取 Trello 附件。"
  },
  "panelTitle": {
    "message": "Kanbonk 导出"
  },
  "panelCollapse": {
    "message": "收起"
  },
  "panelExpand": {
    "message": "展开"
  },
  "panelIntro": {
    "message": "将此看板连同所有文件导出供 Kanbonk 使用。"
  },
  "panelHint": {
    "message": "约 100 MB 的 ZIP 分卷会保存到你的下载文件夹。如果浏览器询问，请允许此网站下载多个文件。"
  },
  "exportBoard": {
    "message": "导出看板"
  },
  "exportAgain": {
    "message": "再次导出"
  },
  "exportCancel": {
    "message": "取消"
  },
  "progressBoard": {
    "message": "正在读取看板…"
  },
  "progressComments": {
    "message": "正在读取评论… $COUNT$",
    "placeholders": {
      "count": {
        "content": "$1",
        "example": "120"
      }
    }
  },
  "progressStickers": {
    "message": "正在读取贴纸…"
  },
  "progressSaving": {
    "message": "正在保存第 $PART$ 个分卷…",
    "placeholders": {
      "part": {
        "content": "$1",
        "example": "2"
      }
    }
  },
  "sizeMegabytes": {
    "message": "$SIZE$ MB",
    "placeholders": {
      "size": {
        "content": "$1",
        "example": "1.5"
      }
    }
  },
  "sizeOfTotal": {
    "message": "$DONE$ / $TOTAL$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "12 MB"
      },
      "total": {
        "content": "$2",
        "example": "80 MB"
      }
    }
  },
  "progressFiles": {
    "message": "文件 $DONE$ / $TOTAL$ · $SIZE$\n分卷 $PART$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "3"
      },
      "total": {
        "content": "$2",
        "example": "10"
      },
      "size": {
        "content": "$3",
        "example": "12 MB of 80 MB"
      },
      "part": {
        "content": "$4",
        "example": "1"
      }
    }
  },
  "doneOnePart": {
    "message": "完成：共 $PARTS$ 个分卷，已导出 $FILES$ / $TOTAL$ 个文件。\n在 Kanbonk 中打开 ⋯ → 从 Trello 导入，然后一次选择所有分卷。",
    "placeholders": {
      "parts": {
        "content": "$1",
        "example": "1"
      },
      "files": {
        "content": "$2",
        "example": "9"
      },
      "total": {
        "content": "$3",
        "example": "10"
      }
    }
  },
  "doneManyParts": {
    "message": "完成：共 $PARTS$ 个分卷，已导出 $FILES$ / $TOTAL$ 个文件。\n在 Kanbonk 中打开 ⋯ → 从 Trello 导入，然后一次选择所有分卷。",
    "placeholders": {
      "parts": {
        "content": "$1",
        "example": "3"
      },
      "files": {
        "content": "$2",
        "example": "9"
      },
      "total": {
        "content": "$3",
        "example": "10"
      }
    }

{
  "appName": {
    "message": "Kanbonk: импорт из Trello"
  },
  "appDescription": {
    "message": "Экспортирует доску Trello со всеми файлами для Kanbonk и позволяет Kanbonk на localhost скачивать вложения Trello."
  },
  "panelTitle": {
    "message": "Экспорт в Kanbonk"
  },
  "panelCollapse": {
    "message": "Свернуть"
  },
  "panelExpand": {
    "message": "Развернуть"
  },
  "panelIntro": {
    "message": "Экспортируйте эту доску со всеми файлами для Kanbonk."
  },
  "panelHint": {
    "message": "ZIP-части примерно по 100 МБ сохраняются в папку загрузок. Если браузер спросит, разрешите этому сайту скачивать несколько файлов."
  },
  "exportBoard": {
    "message": "Экспортировать доску"
  },
  "exportAgain": {
    "message": "Экспортировать снова"
  },
  "exportCancel": {
    "message": "Отмена"
  },
  "progressBoard": {
    "message": "Чтение доски…"
  },
  "progressComments": {
    "message": "Чтение комментариев… $COUNT$",
    "placeholders": {
      "count": {
        "content": "$1",
        "example": "120"
      }
    }
  },
  "progressStickers": {
    "message": "Чтение стикеров…"
  },
  "progressSaving": {
    "message": "Сохранение части $PART$…",
    "placeholders": {
      "part": {
        "content": "$1",
        "example": "2"
      }
    }
  },
  "sizeMegabytes": {
    "message": "$SIZE$ МБ",
    "placeholders": {
      "size": {
        "content": "$1",
        "example": "1.5"
      }
    }
  },
  "sizeOfTotal": {
    "message": "$DONE$ из $TOTAL$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "12 MB"
      },
      "total": {
        "content": "$2",
        "example": "80 MB"
      }
    }
  },
  "progressFiles": {
    "message": "Файлы: $DONE$ из $TOTAL$ · $SIZE$\nЧасть $PART$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "3"
      },
      "total": {
        "content": "$2",
        "example": "10"
      },
      "size": {
        "content": "$3",
        "example": "12 MB of 80 MB"
      },
      "part": {
        "content": "$4",
        "example": "1"
      }
    }
  },
  "doneOnePart": {
    "message": "Готово. Частей: $PARTS$, файлов: $FILES$ из $TOTAL$.\nВ Kanbonk откройте ⋯ → Импорт из Trello и выберите все части сразу.",
    "placeholders": {
      "parts": {
        "content": "$1",
        "example": "1"

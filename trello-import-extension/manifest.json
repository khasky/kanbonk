{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.2.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "key": "",
  "host_permissions": [
    "https://trello.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://trello.com/*"
      ],
      "js": [
        "exporter.js",
        "content.js",
        "panel.js"
      ]
    }
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
